{
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "declaration": true,
    "outDir": "./dist/",
    "removeComments": true,
    "strict": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "lib": ["DOM", "ESNext"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
  ],
  "exclude": [
    "node_modules",
  ]
}